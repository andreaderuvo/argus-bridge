{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "argus-bridge",
  "version": "0.1.5",
  "identifier": "io.github.andreaderuvo.argus-sync",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "argus-bridge",
        "width": 760,
        "height": 620,
        "minWidth": 420,
        "minHeight": 420,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "msi",
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "shortDescription": "Your computer and an Argus server, linked: folders in sync, a terminal, its browser for the agents",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "argus-sync",
          "argus-bridge"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwNTFFQzZGN0YxQjgzQjAKUldTd2d4dC9iK3hSSUJmUjAxQlJLYzNIdit3andTaWlnclFOR0dYSG9XNFFzdVdCM0ZCSGE2dGEK",
      "endpoints": [
        "https://github.com/andreaderuvo/argus-bridge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
